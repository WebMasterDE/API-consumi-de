# Copia questo file in .env e compila i valori

# --- Autenticazione API (JWT) ---
# Stringa casuale lunga, es. generata con: openssl rand -hex 64
JWT_SECRET=

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
USERNAME_DB=
PW_DB=

# "production" disattiva il log delle query SQL
NODE_ENV=development

# --- Sungrow iSolarCloud (Developer Portal > Applications) ---
# Appkey dell'applicazione
APP_ID=
# Secret key dell'applicazione (inviata come header x-access-key)
SECRET_KEY=
# Deve coincidere esattamente con il Redirect URI configurato nel Developer Portal
OAUTH_REDIRECT_URI=https://consumi.divisionenergia.it/api/v1/oauth/callback
